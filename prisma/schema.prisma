// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Enum_Role {
  ADMIN
  USER
}

// Tipo de movimiento sobre un Proyecto: ENTRADA = se agregan tareas nuevas
// (sube el saldo de tareas pendientes), SALIDA = se completan tareas (baja el saldo).
enum Enum_TipoMovimiento {
  ENTRADA
  SALIDA
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  lastName  String?
  password  String
  image     String?
  deleted   Boolean   @default(false)
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  role      Enum_Role @default(USER)

  sessions             Session[]
  proyectosCreados     Proyecto[]   @relation("ProyectosCreadosPor")
  movimientosEjecutados Movimiento[] @relation("MovimientosEjecutadosPor")
}

// Sesión de autenticación: el token se guarda hasheado en la cookie httpOnly
// del navegador y se valida contra este registro en cada request protegido.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// "Maestro" del enunciado: un Proyecto de tareas. `saldo` = tareas pendientes.
model Proyecto {
  id        String   @id @default(cuid())
  nombre    String
  saldo     Int      @default(0)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creador   User   @relation("ProyectosCreadosPor", fields: [creadorId], references: [id])
  creadorId String

  movimientos Movimiento[]
}

// "Movimiento"/Transacción del enunciado: un evento sobre las tareas de un
// Proyecto (se agregan tareas nuevas, o se completan tareas existentes).
model Movimiento {
  id       String              @id @default(cuid())
  fecha    DateTime            @default(now())
  tipo     Enum_TipoMovimiento
  cantidad Int
  createdAt DateTime           @default(now())

  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId String

  responsable   User   @relation("MovimientosEjecutadosPor", fields: [responsableId], references: [id])
  responsableId String
}
